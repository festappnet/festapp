+// Dilate the kernel's exact hit regions by eight CSS pixels. Probe nearest
+// screen pixels first, reusing canonical geometry for rotations and groups.
+// Unavailable seats participate too, so snapping cannot jump across them.
+const seatHitOffsets = [];
+for (let x = -8; x <= 8; x++) for (let y = -8; y <= 8; y++) {
+  const distance = x * x + y * y;
+  if (distance > 0 && distance <= 64) seatHitOffsets.push({x, y, distance});
+}
+seatHitOffsets.sort((a, b) => a.distance - b.distance);
+function hitTestSeatTap(handle, event, inverse, point) {
+  const kernel = globalThis.VenueLayoutKernel;
+  const direct = kernel.hitTest(handle.json, point.x, point.y);
+  if (direct) return direct;
+  const bounds = handle.svg.getBoundingClientRect();
+  if (event.clientX < bounds.left || event.clientX >= bounds.right ||
+      event.clientY < bounds.top || event.clientY >= bounds.bottom) return null;
+  for (const offset of seatHitOffsets) {
+    const x = event.clientX + offset.x, y = event.clientY + offset.y;
+    if (x < bounds.left || x >= bounds.right || y < bounds.top || y >= bounds.bottom) continue;
+    const nearby = new DOMPoint(x, y).matrixTransform(inverse);
+    const id = kernel.hitTest(handle.json, nearby.x, nearby.y);
