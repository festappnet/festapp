{
  "name": "festapp-web-client",
  "version": "0.20.478",
  "description": "Standalone Web Client for Festapp",
  "type": "module",
  "scripts": {
    "dev": "node ../automation/configure_fonts.js .. --assets-only && vite",
    "build": "node ../automation/configure_fonts.js .. --assets-only && vite build",
    "preview": "vite preview",
    "prestart": "node ../automation/configure_version.js",
    "start": "pnpm run dev",
    "test": "node ../automation/generate_email_tlds.mjs --check && node --test tests/**/*.test.js",
    "test:security-browser": "node scripts/test_web_security_browser.mjs",
    "test:seat-checkout-browser": "node scripts/test_seat_checkout_browser.mjs",
    "test:form-access-browser": "node scripts/test_form_access_browser.mjs"
  },
  "dependencies": {
    "@festapp/venue-layout": "file:vendor/festapp-venue-layout-0.3.8-fcab9011e3a1.tgz",
    "@supabase/supabase-js": "^2.118.0",
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "flatpickr": "^4.6.13",
    "glob": "^13.0.6",
    "jsqr": "^1.4.0",
    "node-localstorage": "^3.0.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "parse5": "^8.0.1",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "pnpm": "11.24.0"
  }
}
