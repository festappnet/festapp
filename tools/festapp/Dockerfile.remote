FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS api-build
WORKDIR /app
ARG FESTAPP_SOURCE_SHA
ENV FESTAPP_SOURCE_SHA=$FESTAPP_SOURCE_SHA
COPY tools/festapp/package.json tools/festapp/pnpm-lock.yaml tools/festapp/pnpm-workspace.yaml ./tools/festapp/
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate && pnpm --dir tools/festapp install --frozen-lockfile --ignore-scripts
COPY tools/festapp/src ./tools/festapp/src
COPY tools/festapp/scripts ./tools/festapp/scripts
COPY tools/festapp/api-contract-archive.json tools/festapp/api-release-baseline.json tools/festapp/redocly.yaml ./tools/festapp/
COPY packages/festapp_contracts ./packages/festapp_contracts
COPY assets/translations/cs.json ./assets/translations/cs.json
COPY supabase/functions/_shared/ticket-assets/font-catalog.json ./supabase/functions/_shared/ticket-assets/font-catalog.json
COPY automation/lib/backend_activation_manifest.mjs ./automation/lib/backend_activation_manifest.mjs
COPY automation/lib/supabase_client_config.mjs ./automation/lib/supabase_client_config.mjs
COPY automation/release/help/mcp_reference.mjs ./automation/release/help/mcp_reference.mjs
RUN test -n "$FESTAPP_SOURCE_SHA" && pnpm --dir tools/festapp run api:prepare

FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
ENV NODE_ENV=production
WORKDIR /app
COPY tools/festapp/package.json tools/festapp/pnpm-lock.yaml tools/festapp/pnpm-workspace.yaml ./tools/festapp/
COPY tools/festapp/scripts/runtime-notices.mjs ./tools/festapp/scripts/runtime-notices.mjs
COPY LICENCE ./LICENCE
COPY automation/release/legal/mcp-privacy.en.md automation/release/legal/mcp-privacy.cs.md automation/release/legal/mcp-terms.en.md automation/release/legal/mcp-terms.cs.md ./automation/release/legal/
COPY tools/festapp/licenses ./tools/festapp/licenses
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
RUN pnpm --dir tools/festapp install --frozen-lockfile --prod --ignore-scripts
RUN pnpm --dir tools/festapp licenses list --prod --json | node tools/festapp/scripts/runtime-notices.mjs /app/THIRD_PARTY_NOTICES
COPY tools/festapp/src ./tools/festapp/src
COPY --from=api-build /app/tools/festapp/contracts/api-v1 ./tools/festapp/contracts/api-v1
COPY packages/festapp_contracts ./packages/festapp_contracts
COPY assets/translations/cs.json ./assets/translations/cs.json
COPY supabase/functions/_shared/ticket-assets/font-catalog.json ./supabase/functions/_shared/ticket-assets/font-catalog.json
COPY automation/lib/backend_activation_manifest.mjs ./automation/lib/backend_activation_manifest.mjs
USER node
CMD ["node", "--max-old-space-size=192", "tools/festapp/src/remote/main.mjs", "serve", "/run/festapp/config.json", "--secrets", "/run/festapp/secrets.json", "--data", "/var/lib/festapp-mcp", "--port", "3399"]
