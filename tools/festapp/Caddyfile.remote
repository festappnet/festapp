# Add only after the reviewed image/config/keys and loopback probes pass.
# Keep the existing canonical API/admin site blocks unchanged.
mcp.festapp.net {
    # Preserve the canonical API's Cloudflare-edge/loopback origin boundary.
	@untrusted not remote_ip 127.0.0.1/32 ::1/128 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @untrusted {
		respond "Forbidden" 403
	}
    request_body {
        max_size 48KB
    }
    header -Server
    reverse_proxy 127.0.0.1:3399 {
        header_up Host mcp.festapp.net
        header_up X-Forwarded-Proto https
        header_up -Forwarded
    }
    # Intentionally no access log: auth URLs can contain login context.
    # The Node sidecar emits bounded, redacted consent/operation/outcome events.
}
