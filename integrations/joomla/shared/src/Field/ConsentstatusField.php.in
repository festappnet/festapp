<?php
namespace Festapp\Module\@@NAMESPACE@@\Site\Field;
use Joomla\CMS\Form\FormField;
use Joomla\CMS\Language\Text;
use Festapp\Module\@@NAMESPACE@@\Site\Helper\EmbedHelper;
defined('_JEXEC') or die;
final class ConsentstatusField extends FormField
{
    protected $type = 'Consentstatus';
    protected function getInput()
    {
        $config = EmbedHelper::consent(['consent_enabled'=>$this->form->getValue('consent_enabled','params'), 'consent_export'=>$this->form->getValue('consent_export','params')]);
        $key = $config ? '@@KEY@@_CONSENT_ACCEPTED' : '@@KEY@@_CONSENT_OFF';
        return '<p>' . htmlspecialchars(Text::_($key), ENT_QUOTES, 'UTF-8') . '</p><p>' . htmlspecialchars(Text::_('@@KEY@@_CONSENT_COOP'), ENT_QUOTES, 'UTF-8') . '</p>';
    }
}
