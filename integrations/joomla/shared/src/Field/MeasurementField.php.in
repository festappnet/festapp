namespace Festapp\Module\@@NAMESPACE@@\Site\Field;

use Joomla\CMS\Form\Field\ListField;

defined('_JEXEC') or die;

/** Only a new module gets Website mode; saved modules keep the unit fallback. */
class MeasurementField extends ListField
{
    protected $type = 'Measurement';

    protected function getInput()
    {
        if (!(int) $this->form->getValue('id') && $this->form->getValue('measurement', 'params') === null) {
            $this->value = 'host';
        }
        return parent::getInput();
    }
}
