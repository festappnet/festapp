namespace Festapp\Module\@@NAMESPACE@@\Site\Filter;

use Joomla\CMS\Form\Form;
use Joomla\CMS\Form\FormFilterInterface;
use Joomla\Registry\Registry;

defined('_JEXEC') or die;

/** Consent settings are stored exactly as entered, without surrounding whitespace. */
final class ConsentFilter implements FormFilterInterface
{
    public function filter(\SimpleXMLElement $element, $value, $group = null, ?Registry $input = null, ?Form $form = null)
    {
        return is_string($value) ? trim($value) : '';
    }
}
