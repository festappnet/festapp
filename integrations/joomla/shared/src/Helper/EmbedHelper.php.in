namespace Festapp\Module\@@NAMESPACE@@\Site\Helper;

use Joomla\CMS\Language\Text;

defined('_JEXEC') or die;

final class EmbedHelper
{
    /** Largest Cookiebot consent lifetime the service helper accepts (365 days). */
    public const CONSENT_MAX_AGE = 31536000;

    public static function validateUrl($input): bool
    {
        $prefix = '@@ORIGIN@@/form/';
        if (!is_string($input) || strlen($input) > 2048 || !str_starts_with($input, $prefix)) {
            return false;
        }
        $slug = substr($input, strlen($prefix));
        $decoded = rawurldecode($slug);
        return preg_match('/\A[\p{L}\p{N}_-]+\z/uD', $decoded) === 1 && rawurlencode($decoded) === $slug;
    }

    public static function settings(array $params): ?array
    {
        if (!self::validateUrl($params['url'] ?? null)) {
            return null;
        }
        $height = is_scalar($params['height'] ?? null) ? filter_var($params['height'], FILTER_VALIDATE_INT) : false;
        $height = $height !== false && $height >= 240 && $height <= 4000 ? $height : 800;
        $auto = ($params['mode'] ?? 'auto') !== 'fixed';
        $title = is_string($params['iframe_title'] ?? null) ? trim($params['iframe_title']) : '';
        $text = is_string($params['link_text'] ?? null) ? trim($params['link_text']) : '';
        $class = is_string($params['link_class'] ?? null) ? trim($params['link_class']) : '';
        return [
            'url' => $params['url'], 'height' => $height, 'auto' => $auto,
            'measurement' => ($params['measurement'] ?? 'unit') === 'host' ? 'host' : 'unit',
            'title' => $title !== '' ? $title : Text::_('@@KEY@@_DEFAULT_TITLE'),
            // Missing or unknown values keep the existing iframe rendering.
            'output' => ($params['output'] ?? 'embed') === 'link' ? 'link' : 'embed',
            'link_text' => $text,
            'link_class' => preg_match('/\A[A-Za-z0-9_ -]{1,200}\z/D', $class) === 1 ? $class : '',
        ];
    }

    /** Consent transfer is opt-in; any other stored value keeps it off. */
    public static function consentEnabled(array $params): bool
    {
        return in_array($params['consent_link'] ?? null, [1, '1', true], true);
    }

    /**
     * Organizer-saved coverage assertion for the service helper, or null.
     * Mirrors the helper's own Cookiebot/CookieConsent validation and never
     * derives a value from the current request.
     */
    public static function consent(array $params): ?array
    {
        if (!self::consentEnabled($params) || self::consentErrors($params) !== []) {
            return null;
        }
        $provider = $params['consent_provider'];
        $config = [
            'provider' => $provider,
            'organization' => self::positiveInteger($params['consent_organization'] ?? null),
            'unit' => self::positiveInteger($params['consent_unit'] ?? null),
            'consentRevision' => self::text($params['consent_revision'] ?? null),
        ];
        $attributes = [];
        if ($provider === 'cookiebot') {
            $config += [
                'cbid' => self::text($params['consent_cbid'] ?? null),
                'origin' => self::text($params['consent_origin'] ?? null),
                'consentValidFrom' => self::text($params['consent_valid_from'] ?? null),
                'maxAgeSeconds' => self::positiveInteger($params['consent_max_age'] ?? null),
            ];
            // Cookiebot automatic blocking must leave the service helper running.
            $attributes['data-cookieconsent'] = 'ignore';
        } else {
            $config['revision'] = self::positiveInteger($params['consent_cc_revision'] ?? null);
            $categories = self::categories($params);
            if ($categories !== ['analytics' => 'analytics', 'marketing' => 'marketing']) {
                $config['categories'] = $categories;
            }
        }
        $json = json_encode($config, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
        $attributes['data-festapp-consent'] = $json;
        return ['provider' => $provider, 'json' => $json, 'attributes' => $attributes];
    }

    /** Language key suffixes of invalid consent settings; empty when valid or disabled. */
    public static function consentErrors(array $params): array
    {
        if (!self::consentEnabled($params)) {
            return [];
        }
        $provider = $params['consent_provider'] ?? null;
        if (!in_array($provider, ['cookiebot', 'cookieconsent'], true)) {
            return ['CONSENT_PROVIDER'];
        }
        $errors = [];
        foreach (['consent_organization' => 'CONSENT_ORGANIZATION', 'consent_unit' => 'CONSENT_UNIT'] as $name => $label) {
            if (self::positiveInteger($params[$name] ?? null) === null) {
                $errors[] = $label;
            }
        }
        if (preg_match('/\A[a-f0-9]{32}\z/D', self::text($params['consent_revision'] ?? null)) !== 1) {
            $errors[] = 'CONSENT_REVISION';
        }
        if ($provider === 'cookiebot') {
            if (preg_match('/\A[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\z/iD', self::text($params['consent_cbid'] ?? null)) !== 1) {
                $errors[] = 'CONSENT_CBID';
            }
            if (!self::origin(self::text($params['consent_origin'] ?? null))) {
                $errors[] = 'CONSENT_ORIGIN';
            }
            if (!self::instant(self::text($params['consent_valid_from'] ?? null))) {
                $errors[] = 'CONSENT_VALID_FROM';
            }
            $age = self::positiveInteger($params['consent_max_age'] ?? null);
            if ($age === null || $age > self::CONSENT_MAX_AGE) {
                $errors[] = 'CONSENT_MAX_AGE';
            }
        } else {
            if (self::positiveInteger($params['consent_cc_revision'] ?? null) === null) {
                $errors[] = 'CONSENT_CC_REVISION';
            }
            if (self::categories($params) === null) {
                $errors[] = 'CONSENT_CC_CATEGORIES';
            }
        }
        return $errors;
    }

    /** Exact serialized HTTPS origin of a named host: lowercase, no path, no default port. */
    public static function origin(string $value): bool
    {
        $label = '[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?';
        if (strlen($value) > 270 || preg_match('/\Ahttps:\/\/(?:' . $label . '\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::([1-9][0-9]{0,4}))?\z/D', $value, $match) !== 1) {
            return false;
        }
        return !isset($match[1]) || ((int) $match[1] <= 65535 && (int) $match[1] !== 443);
    }

    /** ISO UTC instant with milliseconds, exactly as Date#toISOString() serializes it. */
    public static function instant(string $value): bool
    {
        if (preg_match('/\A\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z\z/D', $value) !== 1) {
            return false;
        }
        $date = \DateTimeImmutable::createFromFormat('!Y-m-d\TH:i:s.v\Z', $value, new \DateTimeZone('UTC'));
        return $date !== false && $date->format('Y-m-d\TH:i:s.v\Z') === $value;
    }

    public static function render(array $params, bool $consentLink = false): string
    {
        $s = self::settings($params);
        if ($s === null) {
            return '<p class="@@ELEMENT@@-error">' . self::escape(Text::_('@@KEY@@_INVALID_URL')) . '</p>';
        }
        // Only a link backed by a configured page helper keeps its opener; otherwise the legacy link is unchanged.
        $link = sprintf(
            '<a%s href="%s" target="_blank" %s>%s</a>',
            $s['output'] === 'link' && $s['link_class'] !== '' ? ' class="' . self::escape($s['link_class']) . '"' : '',
            self::escape($s['url']),
            $consentLink ? 'data-festapp-consent-link' : 'rel="noopener noreferrer"',
            self::escape($s['link_text'] !== '' ? $s['link_text'] : Text::_($s['output'] === 'link' ? '@@KEY@@_LINK_DEFAULT' : '@@KEY@@_FALLBACK'))
        );
        if ($s['output'] === 'link') {
            return '<div class="@@ELEMENT@@ @@ELEMENT@@-link"><p>' . $link . '</p></div>';
        }
        return sprintf(
            '<div class="@@ELEMENT@@" data-festapp-embed-host><iframe%s src="%s" title="%s" height="%d" style="display:block;width:100%%;max-width:100%%;border:0;color-scheme:light dark" loading="lazy"></iframe><p>%s</p></div>',
            ' data-festapp-embed' . (!$s['auto'] ? ' data-festapp-height="fixed"' : '')
                . ($s['measurement'] === 'host' ? ' data-festapp-datalayer' : ''),
            self::escape($s['url'] . '?embed=1'), self::escape($s['title']), $s['height'], $link
        );
    }

    private static function categories(array $params): ?array
    {
        $categories = [];
        foreach (['analytics', 'marketing'] as $purpose) {
            $name = $params['consent_cc_' . $purpose] ?? null;
            $name = $name === null || $name === '' ? $purpose : $name;
            // Website category name, 1-128 UTF-16 code units as the helper counts them.
            if (!is_string($name) || preg_match('//u', $name) !== 1 || preg_match('/[\x00-\x1F\x7F]/', $name) === 1) {
                return null;
            }
            $units = strlen(mb_convert_encoding($name, 'UTF-16LE', 'UTF-8')) / 2;
            if ($units < 1 || $units > 128) {
                return null;
            }
            $categories[$purpose] = $name;
        }
        return $categories['analytics'] !== $categories['marketing'] ? $categories : null;
    }

    private static function positiveInteger($value): ?int
    {
        if (is_string($value) && preg_match('/\A[1-9][0-9]{0,15}\z/D', trim($value)) === 1) {
            $value = (int) trim($value);
        }
        // JavaScript safe integer range, as Number.isSafeInteger in the helper.
        return is_int($value) && $value > 0 && $value <= 9007199254740991 ? $value : null;
    }

    private static function text($value): string
    {
        return is_string($value) ? trim($value) : '';
    }

    private static function escape(string $value): string
    {
        return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    }
}
