{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "@@SLUG@@/form-link",
  "version": "@@VERSION@@",
  "title": "@@NAME@@ form link",
  "category": "widgets",
  "icon": "external",
  "description": "A button or link opening a saved public @@NAME@@ form in a new tab.",
  "textdomain": "@@SLUG@@",
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "style": {
      "type": "string",
      "enum": [
        "button",
        "link"
      ],
      "default": "button"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "@@SLUG@@-editor",
  "style": "@@SLUG@@"
}
