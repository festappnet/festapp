<?php
/**
 * Local onboarding. No remote administration, settings or API keys.
 *
 * @package @@NAMESPACE@@
 */

namespace @@NAMESPACE@@;

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/** Register capability-protected help. */
function admin_menu() {
	add_options_page( '@@NAME@@', '@@NAME@@', 'manage_options', '@@SLUG@@', __NAMESPACE__ . '\admin_page' );
}

/**
 * Make the first step discoverable directly after activation.
 *
 * @param array $links Existing plugin actions.
 * @return array
 */
function plugin_action_links( $links ) {
	if ( current_user_can( 'manage_options' ) ) {
		array_unshift( $links, '<a href="' . esc_url( admin_url( 'options-general.php?page=@@SLUG@@' ) ) . '">' . esc_html__( 'Get started', '@@SLUG@@' ) . '</a>' );
	}
	return $links;
}

/** Render help using native WordPress layout and controls. */
function admin_page() {
	if ( ! current_user_can( 'manage_options' ) ) {
		return;
	}
	?>
	<div class="wrap">
		<h1><?php esc_html_e( 'Tickets on your website', '@@SLUG@@' ); ?></h1>
		<p><?php esc_html_e( 'Embed a form from your @@NAME@@ account. Manage events, orders and admission in the service.', '@@SLUG@@' ); ?></p>
		<div class="card">
		<h2><?php esc_html_e( '1. Prepare your form', '@@SLUG@@' ); ?></h2>
		<p><?php esc_html_e( 'Create an organizer account in @@NAME@@, use the sign-in details from its email, then create your event and save a public form. A WordPress login does not create a service account.', '@@SLUG@@' ); ?></p>
		<p><a class="button button-primary" href="@@LOGIN_URL@@" target="_blank" rel="noopener noreferrer"><?php esc_html_e( 'Create an account or sign in', '@@SLUG@@' ); ?></a></p>
		<p><?php esc_html_e( 'Paid sales also require your payment and organizer details in the service.', '@@SLUG@@' ); ?></p>
		<ol>
			<li><?php esc_html_e( 'Sign in to @@NAME@@, open your event and save the form.', '@@SLUG@@' ); ?></li>
			<li><?php esc_html_e( 'Copy the public URL in the form @@ORIGIN@@/form/saved-slug. Do not use a personal order link or administration URL.', '@@SLUG@@' ); ?></li>
		</ol>
		</div>
		<div class="card">
		<h2><?php esc_html_e( '2. Add the form to a page', '@@SLUG@@' ); ?></h2>
		<p><?php esc_html_e( 'Open a new or existing WordPress page. Use the block inserter (+), search for @@NAME@@ and paste your public form URL into the block.', '@@SLUG@@' ); ?></p>
		<?php if ( current_user_can( 'edit_pages' ) ) : ?>
		<p><a class="button button-secondary" href="<?php echo esc_url( admin_url( 'post-new.php?post_type=page' ) ); ?>"><?php esc_html_e( 'Create a page', '@@SLUG@@' ); ?></a></p>
		<?php endif; ?>
		<p><?php esc_html_e( 'Automatic height is enabled. The appearance option in the block explicitly controls whether the WordPress theme overrides the appearance from the app.', '@@SLUG@@' ); ?></p>
		</div>
		<div class="card">
		<h2><?php esc_html_e( '3. Preview and publish', '@@SLUG@@' ); ?></h2>
		<p><?php esc_html_e( 'The editor shows the block settings. Save the page and open its preview to see the real form, then publish when you are ready.', '@@SLUG@@' ); ?></p>
		<p><?php esc_html_e( 'Visitors buy tickets on your published page. Manage orders, payments and admission in your @@NAME@@ account.', '@@SLUG@@' ); ?></p>
		</div>
		<details>
		<summary><?php esc_html_e( 'Shortcode, display options and service information', '@@SLUG@@' ); ?></summary>
		<h2><?php esc_html_e( 'Shortcode and height', '@@SLUG@@' ); ?></h2>
		<p><code>[@@SHORTCODE@@ url="@@ORIGIN@@/form/saved-slug" title="Tickets for our event"]</code></p>
		<p><code>[@@SHORTCODE@@ url="@@ORIGIN@@/form/saved-slug" mode="fixed" height="800"]</code></p>
		<p><?php esc_html_e( 'Automatic height loads the service helper. Fixed height (240-4000 px) scrolls within the form. The link below the form works without the helper. If your theme or security policy blocks embedding, visitors can open the form in a new tab.', '@@SLUG@@' ); ?></p>
		<p><?php esc_html_e( 'The WordPress appearance override replaces the app font, background and colors only for this block. It does not change the saved form in the app or the seating map. Disable it to use the app appearance; for a shortcode, add inherit_style="false".', '@@SLUG@@' ); ?></p>
		<h2><?php esc_html_e( 'External service and privacy', '@@SLUG@@' ); ?></h2>
		<p><?php esc_html_e( 'The published form connects to @@NAME@@. The service receives the IP address and browser information; visitors enter purchase data directly into the service. Automatic height also loads /embed.js. The plugin does not copy orders or credentials into WordPress and adds no analytics. Review storage, cookies and consent requirements for the service and your website. Activation, this help page and the editor do not load the remote form.', '@@SLUG@@' ); ?></p>
		<p>
			<a href="@@ORIGIN@@/" target="_blank" rel="noopener noreferrer"><?php esc_html_e( 'Open @@NAME@@', '@@SLUG@@' ); ?></a> |
			<a href="@@ORIGIN@@/privacy/" target="_blank" rel="noopener noreferrer"><?php esc_html_e( 'Privacy policy', '@@SLUG@@' ); ?></a> |
			<a href="@@ORIGIN@@/terms/" target="_blank" rel="noopener noreferrer"><?php esc_html_e( 'Service terms', '@@SLUG@@' ); ?></a> |
			<a href="@@ORIGIN@@/support/" target="_blank" rel="noopener noreferrer"><?php esc_html_e( 'Support', '@@SLUG@@' ); ?></a>
		</p>
		<p><?php esc_html_e( 'If a purchase result is uncertain, check the order with the organizer before buying again. Payments and seat availability are controlled by the service. Deactivation or deletion does not delete service orders; raw shortcode text may then appear on the page.', '@@SLUG@@' ); ?></p>
		</details>
	</div>
	<?php
}
