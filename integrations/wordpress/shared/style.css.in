.@@SLUG@@ { width: 100%; }
.@@SLUG@@ iframe { display: block; width: 100%; }
.@@SLUG@@ a { text-underline-offset: .2em; }
.@@SLUG@@ a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
.@@SLUG@@-editor { padding: 24px; border: 1px solid #757575; }
.@@SLUG@@-editor h3 { margin-top: 0; }
.@@SLUG@@-editor p { max-width: 70ch; }
