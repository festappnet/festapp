/* Source distributed directly. WordPress provides dependencies; no build. */
(function (blocks, element, editor, components, i18n) {
    'use strict';
    const el = element.createElement;
    const __ = i18n.__;
    blocks.registerBlockType('@@SLUG@@/ticket-form', {
        edit: function (props) {
            const a = props.attributes;
            // Advisory only. PHP validates the exact origin and canonical path.
            const origins = window.@@EDITOR_GLOBAL@@.origins;
            const plausible = origins.some((origin) => a.url.startsWith(origin + '/form/') && /^(?:[A-Za-z0-9_-]|%[A-F0-9]{2})+$/.test(a.url.slice(origin.length + 6)));
            return el('div', editor.useBlockProps({className: '@@SLUG@@-editor'}),
                el('h3', null, '@@NAME@@'),
                el('p', null, __('Paste the saved public form URL. Manage orders in @@NAME@@.', '@@SLUG@@')),
                el('p', null, el('a', {href: '@@LOGIN_URL@@', target: '_blank', rel: 'noopener noreferrer'}, __('Create an account or sign in', '@@SLUG@@'))),
                el(components.TextControl, {label: __('Form URL', '@@SLUG@@'), value: a.url, type: 'url',
                    placeholder: '@@ORIGIN@@/form/saved-slug',
                    onChange: (url) => props.setAttributes({url}),
                    help: __('Use @@ORIGIN@@/form/saved-slug without query parameters or personal fragments.', '@@SLUG@@')}),
                a.url && !plausible ? el(components.Notice, {status: 'warning', isDismissible: false}, __('Check the public URL. The server accepts only an allowed form address.', '@@SLUG@@')) : null,
                el(components.TextControl, {label: __('Form title', '@@SLUG@@'), value: a.title, onChange: (title) => props.setAttributes({title}),
                    help: __('Describe this form for visitors using screen readers. This does not rename the event.', '@@SLUG@@')}),
                el(components.SelectControl, {label: __('Form height', '@@SLUG@@'), value: a.mode,
                    options: [{label: __('Automatic', '@@SLUG@@'), value: 'auto'}, {label: __('Fixed', '@@SLUG@@'), value: 'fixed'}], onChange: (mode) => props.setAttributes({mode})}),
                el(components.ToggleControl, {label: __('Match website style', '@@SLUG@@'), checked: a.inheritStyle, onChange: (inheritStyle) => props.setAttributes({inheritStyle}),
                    help: __('Use the website font family and colors. Seat map keeps its own appearance. Website fonts must allow loading from the service.', '@@SLUG@@')}),
                el(components.RangeControl, {label: a.mode === 'fixed' ? __('Height (px)', '@@SLUG@@') : __('Fallback height without the helper (px)', '@@SLUG@@'), value: a.height, min: 240, max: 4000, step: 10, onChange: (height) => props.setAttributes({height})}),
                el('p', null, __('After publication, visitors connect to @@NAME@@ and enter data directly into the service. Automatic height loads its /embed.js. The remote form is not loaded in the editor.', '@@SLUG@@')),
                el('p', null, el('a', {href: '@@ORIGIN@@/privacy/', target: '_blank', rel: 'noopener noreferrer'}, __('Service privacy policy', '@@SLUG@@')))
            );
        },
        save: function () { return null; }
    });
})(window.wp.blocks, window.wp.element, window.wp.blockEditor, window.wp.components, window.wp.i18n);
