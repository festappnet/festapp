{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "festapp-tickets/ticket-form",
  "version": "1.0.0",
  "title": "Festapp Tickets",
  "category": "embed",
  "icon": "tickets-alt",
  "description": "Sell tickets using a saved public Festapp Tickets form.",
  "textdomain": "festapp-tickets",
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "fixed"
      ],
      "default": "auto"
    },
    "inheritStyle": {
      "type": "boolean",
      "default": true
    },
    "height": {
      "type": "number",
      "default": 800
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "festapp-tickets-editor",
  "style": "festapp-tickets"
}
