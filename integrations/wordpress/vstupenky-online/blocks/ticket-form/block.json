{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vstupenky-online/ticket-form",
  "version": "1.0.3",
  "title": "vstupenky.online",
  "category": "embed",
  "icon": "tickets-alt",
  "description": "Sell tickets using a saved public vstupenky.online form.",
  "textdomain": "vstupenky-online",
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "fixed"
      ],
      "default": "auto"
    },
    "inheritStyle": {
      "type": "boolean",
      "default": true
    },
    "height": {
      "type": "number",
      "default": 800
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "vstupenky-online-editor",
  "style": "vstupenky-online"
}
