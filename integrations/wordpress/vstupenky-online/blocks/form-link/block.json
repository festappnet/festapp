{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "vstupenky-online/form-link",
  "version": "1.0.9",
  "title": "vstupenky.online form link",
  "category": "widgets",
  "icon": "external",
  "description": "A button or link opening a saved public vstupenky.online form in a new tab.",
  "textdomain": "vstupenky-online",
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "style": {
      "type": "string",
      "enum": [
        "button",
        "link"
      ],
      "default": "button"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "vstupenky-online-editor",
  "style": "vstupenky-online"
}
