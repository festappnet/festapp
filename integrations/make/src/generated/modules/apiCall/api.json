{
  "url": "https://api.vstupenky.online/{{parameters.url}}",
  "method": "{{ifempty(parameters.method, 'POST')}}",
  "type": "raw",
  "followRedirect": false,
  "followAllRedirect": false,
  "headers": {
    "content-type": "application/json",
    "{{...}}": "{{omit(toCollection(parameters.headers, 'key', 'value'), split(replace(join(keys(toCollection(parameters.headers, 'key', 'value')), ','), '/(?:^|,)(?!(?:host|authorization)(?:,|$))[^,]+/gi', ''), ','))}}",
    "host": "api.vstupenky.online",
    "authorization": "Bearer {{connection.accessToken}}"
  },
  "qs": {
    "{{...}}": "{{toCollection(parameters.qs, 'key', 'value')}}"
  },
  "body": "{{ifempty(parameters.body, '{}')}}",
  "response": {
    "valid": "{{if(statusCode >= 200, statusCode < 300, false)}}",
    "output": {
      "body": "{{body}}",
      "headers": "{{headers}}",
      "statusCode": "{{statusCode}}"
    }
  },
  "log": {
    "sanitize": [
      "request.body",
      "request.headers.authorization",
      "request.headers.Authorization"
    ]
  }
}
