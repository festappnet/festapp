{
  "url": "https://api.vstupenky.online/integrations/v1{{switch(parameters.url, \"/operations/orders.report\", \"/operations/orders.report\", \"/operations/orders.list\", \"/operations/orders.list\", \"/operations/orders.inspect\", \"/operations/orders.inspect\", \"/operations/access.inspect\", \"/operations/access.inspect\", \"/operations/context.inspect\", \"/operations/context.inspect\", '/operations/forbidden')}}",
  "method": "{{ifempty(parameters.method, 'POST')}}",
  "type": "raw",
  "headers": {
    "{{...}}": "{{pick(toCollection(parameters.headers, 'key', 'value'), 'Accept', 'Content-Type', 'X-Request-ID')}}",
    "content-type": "application/json",
    "authorization": "Bearer {{connection.accessToken}}"
  },
  "qs": {
    "{{...}}": "{{toCollection(parameters.qs, 'key', 'value')}}"
  },
  "body": "{{ifempty(parameters.body, '{}')}}",
  "response": {
    "output": {
      "body": "{{body}}",
      "headers": "{{headers}}",
      "statusCode": "{{statusCode}}"
    }
  },
  "log": {
    "sanitize": [
      "request.body",
      "request.headers.authorization",
      "request.headers.Authorization"
    ]
  }
}
