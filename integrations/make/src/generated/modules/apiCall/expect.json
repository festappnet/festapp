[
  {
    "name": "url",
    "label": "URL",
    "type": "text",
    "required": true,
    "validate": {
      "pattern": "^/(?!/)[^\\s\\\\#]*$"
    },
    "help": "Enter a path relative to https://api.vstupenky.online, for example /integrations/v1/operations/context.inspect."
  },
  {
    "name": "method",
    "label": "Method",
    "type": "select",
    "required": true,
    "default": "POST",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "PUT",
        "value": "PUT"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      },
      {
        "label": "HEAD",
        "value": "HEAD"
      },
      {
        "label": "OPTIONS",
        "value": "OPTIONS"
      }
    ],
    "help": "The documented read operations use POST."
  },
  {
    "name": "headers",
    "label": "Headers",
    "type": "array",
    "spec": [
      {
        "name": "key",
        "label": "Key",
        "type": "text",
        "required": true,
        "validate": {
          "pattern": "^(?!(?:[Hh][Oo][Ss][Tt]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])$)[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        "help": "Enter a header name other than Host or Authorization."
      },
      {
        "name": "value",
        "label": "Value",
        "type": "text"
      }
    ],
    "help": "Additional request headers. Host and Authorization are supplied by Make."
  },
  {
    "name": "qs",
    "label": "Query string",
    "type": "array",
    "spec": [
      {
        "name": "key",
        "label": "Key",
        "type": "text"
      },
      {
        "name": "value",
        "label": "Value",
        "type": "text"
      }
    ]
  },
  {
    "name": "body",
    "label": "Body",
    "type": "text",
    "default": "{}",
    "help": "Enter the request body as JSON for an operation that accepts it."
  }
]
