{
  "url": "/operations/orders.report",
  "method": "POST",
  "type": "json",
  "body": {
    "occasionId": "{{parameters.occasionId}}"
  },
  "response": {
    "output": "{{if(body.data.report.generated_at, set(body.data, 'report.generated_at', parseDate(body.data.report.generated_at, 'YYYY-MM-DDTHH:mm:ss.SSSSSSZ')), body.data)}}"
  }
}
