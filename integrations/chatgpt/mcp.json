{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "festapp": {
      "type": "streamable-http",
      "url": "https://mcp.vstupenky.online/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "festapp-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://mcp.vstupenky.online/mcp",
            "baseScopes": [
              "festapp:activities:read",
              "festapp:bank-users:read",
              "festapp:banks:read",
              "festapp:blueprints:read",
              "festapp:cards:read",
              "festapp:email-templates:read",
              "festapp:export-events:read",
              "festapp:export-feedback:read",
              "festapp:export-orders:read",
              "festapp:export-people:read",
              "festapp:export-places:read",
              "festapp:export-speakers:read",
              "festapp:feedback:read",
              "festapp:forms:read",
              "festapp:groups:read",
              "festapp:history:read",
              "festapp:information:read",
              "festapp:inventory:read",
              "festapp:legal:read",
              "festapp:lifecycle:read",
              "festapp:map:read",
              "festapp:occasion-settings:read",
              "festapp:order-history:read",
              "festapp:orders:read",
              "festapp:people:read",
              "festapp:product-options:read",
              "festapp:product-schedules:read",
              "festapp:products:read",
              "festapp:program:read",
              "festapp:quotes:read",
              "festapp:refund-decisions:read",
              "festapp:report-exports:read",
              "festapp:scanner:read",
              "festapp:seats:read",
              "festapp:services:read",
              "festapp:speakers:read",
              "festapp:ticket-layouts:read",
              "festapp:unit-people:read",
              "festapp:unit-settings:read",
              "festapp:waitlist:read",
              "festapp:webhooks:read"
            ]
          }
        }
      }
    }
  }
}
