[
  {
    "kind": "policy",
    "schema": "public",
    "table": "occasions",
    "name": "Enable all for admins",
    "roles": [
      "authenticated"
    ],
    "cmd": "ALL",
    "permissive": "PERMISSIVE",
    "qual": "get_is_admin_on_organization(organization)",
    "check": "get_is_admin_on_organization(organization)"
  },
  {
    "kind": "policy",
    "schema": "public",
    "table": "occasions",
    "name": "Enable read for all",
    "roles": [
      "public"
    ],
    "cmd": "SELECT",
    "permissive": "PERMISSIVE",
    "qual": "true",
    "check": null
  },
  {
    "kind": "policy",
    "schema": "public",
    "table": "occasions",
    "name": "demo_read_fence",
    "roles": [
      "anon",
      "authenticated"
    ],
    "cmd": "SELECT",
    "permissive": "RESTRICTIVE",
    "qual": "(((NOT is_demo_occasion(id)) OR can_read_demo_occasion(id)) AND ((NOT is_demo_unit(unit)) OR demo_unit_can_read(unit)))",
    "check": null
  },
