[
  {
    "name": "canonical order identity",
    "subject": "{{orderSymbol}} - {{occasionTitle}}",
    "html": "<p>{{orderSymbol}}: {{occasionTitle}}</p>",
    "values": {
      "orderSymbol": "ABC123",
      "occasionTitle": "Akce & hosté <večer>"
    },
    "expectedSubject": "ABC123 - Akce & hosté <večer>",
    "expectedHtml": "<p>ABC123: Akce &amp; hosté &lt;večer&gt;</p>"
  },
  {
    "name": "scalar URL and text alongside trusted HTML",
    "subject": "{{occasionTitle}}",
    "html": "<a href='{{order_overview_url}}'>{{occasionTitle}}</a>{{orderCommunication}}",
    "values": {
      "occasionTitle": "Slavnost",
      "order_overview_url": "https://example.invalid/order?a=1&b='2'",
      "orderCommunication": "<p>Dobrý den</p>"
    },
    "expectedSubject": "Slavnost",
    "expectedHtml": "<a href='https://example.invalid/order?a=1&amp;b=&#39;2&#39;'>Slavnost</a><p>Dobrý den</p>"
  },
  {
    "name": "customer text never introduces another substitution",
    "subject": "{{occasionTitle}} / {{orderSymbol}}",
    "html": "<p>{{occasionTitle}} / {{orderSymbol}}</p>",
    "values": {
      "occasionTitle": "{{orderSymbol}}",
      "orderSymbol": "ABC123"
    },
    "expectedSubject": "{{orderSymbol}} / ABC123",
    "expectedHtml": "<p>{{orderSymbol}} / ABC123</p>"
  },
  {
    "name": "HTML sections belong to the body",
    "subject": "{{fullOrder}}",
    "html": "{{fullOrder}}",
    "values": {
      "fullOrder": "<p>Přehled objednávky</p>"
    },
    "expectedSubject": "{{fullOrder}}",
    "expectedHtml": "<p>Přehled objednávky</p>"
  },
  {
    "name": "HTML blocks cannot replace attribute values",
    "subject": "Test",
    "html": "<a href=\"{{fullOrder}}\">{{orderCommunication}}</a>",
    "values": {
      "fullOrder": "<p>Obsah</p>",
      "orderCommunication": "<p>Dobrý den</p>"
    },
    "expectedSubject": "Test",
    "expectedHtml": "<a href=\"{{fullOrder}}\"><p>Dobrý den</p></a>"
  },
  {
    "name": "raw elements and comments keep template-like text",
    "subject": "Test",
    "html": "<style>{{occasionTitle}}</style><!--{{orderSymbol}}--><p>{{occasionTitle}}</p>",
    "values": {
      "occasionTitle": "Akce",
      "orderSymbol": "ABC"
    },
    "expectedSubject": "Test",
    "expectedHtml": "<style>{{occasionTitle}}</style><!--{{orderSymbol}}--><p>Akce</p>"
  },
  {
    "name": "retired team names inside customer data remain literal",
    "values": {
      "occasionTitle": "{{eventTitle}} {{eventUrl}}"
    },
    "subject": "{{occasionTitle}}",
    "html": "<p>{{occasionTitle}}</p>",
    "expectedSubject": "{{eventTitle}} {{eventUrl}}",
    "expectedHtml": "<p>{{eventTitle}} {{eventUrl}}</p>"
  },
  {
    "name": "system team fields use canonical scalar escaping in preview and delivery",
    "values": {
      "appName": "A & B",
      "occasionTitle": "Večer <E>",
      "roleLabel": "Editor",
      "occasionAdminUrl": "https://example.invalid/admin?a=1&b=2",
      "invitationUrl": "https://example.invalid/invite?a=1&b=2"
    },
    "subject": "{{appName}} - {{occasionTitle}}",
    "html": "<p>{{appName}} - {{occasionTitle}} - {{roleLabel}}</p><a href=\"{{occasionAdminUrl}}\">Správa</a><a href=\"{{invitationUrl}}\">Pozvánka</a>",
    "expectedSubject": "A & B - Večer <E>",
    "expectedHtml": "<p>A &amp; B - Večer &lt;E&gt; - Editor</p><a href=\"https://example.invalid/admin?a=1&amp;b=2\">Správa</a><a href=\"https://example.invalid/invite?a=1&amp;b=2\">Pozvánka</a>"
  },
  {
    "name": "password reset links use the common scalar URL contract",
    "subject": "{{email}}",
    "html": "<a href=\"{{resetLink}}\">Obnovit heslo</a>",
    "values": {
      "email": "a&b@example.invalid",
      "resetLink": "https://example.invalid/resetPassword?token=a&next=b"
    },
    "expectedSubject": "a&b@example.invalid",
    "expectedHtml": "<a href=\"https://example.invalid/resetPassword?token=a&amp;next=b\">Obnovit heslo</a>"
  }
]
