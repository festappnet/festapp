[global]
repo1-type=s3
repo1-path=/pgbackrest/festapp-production
repo1-s3-bucket=festapp-supabase-backups
repo1-s3-endpoint=ACCOUNT.r2.cloudflarestorage.com
repo1-s3-region=auto
repo1-s3-uri-style=path
repo1-s3-key=PROVISION_FROM_EXISTING_ROOT_ONLY_CONFIG
repo1-s3-key-secret=PROVISION_FROM_EXISTING_ROOT_ONLY_CONFIG
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=GENERATE_AND_ESCROW_WITH_EXISTING_AGE_RECIPIENT
repo1-retention-full=4
process-max=1
buffer-size=1MiB
compress-type=zst
compress-level=1
archive-async=n
archive-timeout=120
io-timeout=30
log-level-console=warn
log-level-file=info
log-path=/var/lib/pgbackrest/log
lock-path=/var/lib/pgbackrest/lock
spool-path=/var/lib/pgbackrest/spool

[festapp]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user=supabase_admin
pg1-database=postgres
