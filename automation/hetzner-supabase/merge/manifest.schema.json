{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festapp.net/schemas/self-hosted-migration-manifest-v1.json",
  "title": "Festapp self-hosted migration evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "phase",
    "sources",
    "transformation_version",
    "counts",
    "checksums",
    "validation",
    "created_at"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "phase": { "enum": ["inventory", "rehearsal", "cutover", "restore", "contraction"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "project_ref", "schema_fingerprint", "snapshot_at"],
        "properties": {
          "alias": { "enum": ["default", "a", "slunovrat", "canonical"] },
          "project_ref": { "type": "string", "minLength": 1 },
          "schema_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "snapshot_at": { "type": "string", "format": "date-time" },
          "journal_position": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "transformation_version": { "type": "string", "minLength": 1 },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "checksums": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unresolved_conflicts", "orphan_foreign_keys", "journal_lag"],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked"] },
        "unresolved_conflicts": { "type": ["integer", "null"], "minimum": 0 },
        "orphan_foreign_keys": { "type": ["integer", "null"], "minimum": 0 },
        "journal_lag": { "type": ["integer", "null"], "minimum": 0 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "signature": { "type": ["string", "null"] }
  }
}
