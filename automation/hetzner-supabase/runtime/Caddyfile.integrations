# Error IDs are server-generated opaque correlation IDs (not necessarily UUIDs).
# https://caddyserver.com/docs/caddyfile/directives/handle_errors
(festapp_integration_errors) {
    handle_errors 413 {
        @integration_too_large path /integrations/v1 /integrations/v1/* /.well-known/oauth-protected-resource/integrations
        handle @integration_too_large {
            header Content-Type application/problem+json
            header Cache-Control no-store
            header X-Request-Id {err.id}
            header X-Content-Type-Options nosniff
            respond `{"type":"https://api.festapp.net/integrations/problems/body_too_large","title":"BODY_TOO_LARGE","status":413,"code":"BODY_TOO_LARGE","requestId":"{err.id}","retryable":false,"outcome":"rejected"}` 413
        }
        handle {
            respond 413
        }
    }
    handle_errors 502 503 504 {
        @integration_upstream_error path /integrations/v1 /integrations/v1/* /.well-known/oauth-protected-resource/integrations
        handle @integration_upstream_error {
            header Content-Type application/problem+json
            header Cache-Control no-store
            header X-Request-Id {err.id}
            header X-Content-Type-Options nosniff
            respond `{"type":"https://api.festapp.net/integrations/problems/unavailable","title":"UNAVAILABLE","status":{err.status_code},"code":"UNAVAILABLE","requestId":"{err.id}","retryable":true,"outcome":"unknown"}` {err.status_code}
        }
        handle {
            respond {err.status_code}
        }
    }
}

# Import this snippet inside the existing canonical Supabase site BEFORE its
# /.well-known/* handler, after validating the selected listener/DNS/TLS.
# Canonical global MCP listener only. Never point this at the old regional store.
(festapp_global_integrations) {
    import festapp_integration_errors
    @integrations path /integrations/v1 /integrations/v1/* /.well-known/oauth-protected-resource/integrations
    handle @integrations {
        request_body {
            max_size 48KB
        }
        reverse_proxy {$FESTAPP_CANONICAL_MCP_LISTENER:127.0.0.1:3400} {
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -X-Forwarded-For
            header_up Host api.festapp.net
            header_up X-Forwarded-Host api.festapp.net
            header_up X-Forwarded-Proto https
            header_up X-Festapp-Endpoint global-api
            header_up X-Festapp-Client-IP {client_ip}
        }
    }
}

# Add only after DNS/TLS and canonical runtime resource registration are verified.
api.vstupenky.online {
    import festapp_integration_errors
	@untrusted not remote_ip 127.0.0.1/32 ::1/128 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @untrusted {
		respond "Forbidden" 403
	}
    @integrations path /integrations/v1 /integrations/v1/* /.well-known/oauth-protected-resource/integrations
    handle @integrations {
        request_body {
            max_size 48KB
        }
        reverse_proxy {$FESTAPP_CANONICAL_MCP_LISTENER:127.0.0.1:3400} {
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -X-Forwarded-For
            header_up Host api.vstupenky.online
            header_up X-Forwarded-Host api.vstupenky.online
            header_up X-Forwarded-Proto https
            header_up X-Festapp-Endpoint regional-api
            header_up X-Festapp-Client-IP {client_ip}
        }
    }
    handle {
        respond "Not Found" 404
    }
}
