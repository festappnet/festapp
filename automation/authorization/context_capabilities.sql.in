-- Stable capability IDs. The context owner supplies its already-loaded,
-- identity-bound rows from this request, never a cache or caller role claims.
CREATE OR REPLACE FUNCTION public.get_context_capabilities_v1(
  p_occasion bigint,p_occasion_user public.occasion_users,p_unit_user public.unit_users,
  p_admin boolean,p_demo boolean,p_demo_unit boolean,p_demo_read boolean,
  p_has_units boolean,p_current_unit_listed boolean,p_reception_enabled boolean)
RETURNS jsonb LANGUAGE plpgsql STABLE
SET search_path = public, extensions AS $$
DECLARE
 editor boolean := public.active_membership(p_occasion_user.is_editor,p_demo);
 viewer boolean := public.readable_membership(p_occasion_user.is_editor_view,p_demo,p_demo_read);
 manager boolean := public.active_membership(p_occasion_user.is_manager,p_demo);
 unit_editor boolean := public.active_membership(p_unit_user.is_editor,p_demo_unit);
 unit_manager boolean := public.active_membership(p_unit_user.is_manager,p_demo_unit);
 admin boolean := coalesce(p_admin,false);
 actor_present boolean := auth.uid() IS NOT NULL;
 order_reader boolean; order_writer boolean; map_reader boolean;
 form_author boolean; layout_author boolean; administration_navigation boolean;
BEGIN
 -- Each repeated operation fact is evaluated once for this request's loaded
 -- rows. These are local booleans, never a persisted or token permission cache.
 SELECT public.order_read_rule(p_occasion_user.is_editor_order_view,p_demo,p_demo_read),
   public.order_write_rule(p_occasion_user.is_editor_order,p_demo),
   public.map_editor_read_rule(viewer,editor),public.form_authoring_rule(editor,unit_editor),
   p_occasion IS NOT NULL AND public.ticket_layout_rule(actor_present,unit_editor),
   public.administration_navigation_rule(p_demo_read,editor,manager,p_unit_user.is_editor_view,admin)
 INTO order_reader,order_writer,map_reader,form_author,layout_author,administration_navigation;
 RETURN jsonb_build_object(
    'ticket_layouts.read',layout_author,
    'ticket_layouts.write',layout_author,
    'orders.read',order_reader,
    'orders.write',order_writer,
    'occasions.delete',p_occasion IS NOT NULL AND unit_manager,
    'bank_accounts.unit.manage',unit_manager,
    'schedule.feedback.delete',admin,
    'navigation.email_history',admin,
    'orders.delete',p_occasion IS NOT NULL AND public.order_delete_rule(unit_manager,unit_editor,admin),
    'occasions.create',public.occasion_create_rule(unit_manager,unit_editor),
    'occasions.write',p_occasion IS NOT NULL AND public.occasion_edit_rule(unit_editor,unit_editor),
    'users.write',p_occasion IS NOT NULL AND actor_present AND public.occasion_users_write_rule(manager,admin,unit_editor),
    'emails.custom.send',public.custom_email_send_rule(editor,order_writer),
    'email_templates.occasion.read',public.email_template_read_rule(viewer,order_reader),
    'email_templates.occasion.write',public.email_template_write_rule(editor,order_writer),
    'email_templates.unit.read',public.unit_template_read_rule(unit_manager,unit_editor,p_unit_user.is_editor_view),
    'email_templates.unit.write',unit_editor,
    'media.occasion.write',public.occasion_media_upload_rule(editor,order_writer),
    'media.unit.write',unit_editor,
    'unit.settings.write',unit_manager,
    'unit.legal_profile.write',unit_manager,
    'unit.administration.read',coalesce(p_unit_user.is_editor_view,false),
    'companions.assign',public.companion_assignment_rule(actor_present,editor),
    'navigation.schedule_entry_check',public.schedule_entry_navigation_rule(p_occasion_user.is_approver),
    'navigation.cleaning_crew',public.cleaning_crew_navigation_rule(p_occasion_user.is_cleaning_crew),
    'navigation.organization_settings',admin,
    'navigation.occasion_settings',unit_editor OR p_demo_read,
    'forms.create',p_occasion IS NOT NULL AND form_author,
    'forms.delete',p_occasion IS NOT NULL AND form_author,
    'forms.catalog.read',public.form_catalog_read_rule(viewer,order_reader),
    'forms.copy.source',public.form_copy_source_rule(p_occasion_user.is_editor_view,p_unit_user.is_editor_view),
    'forms.copy.target',editor,
    'occasions.editor.read',p_occasion IS NOT NULL AND public.occasion_editor_read_rule(viewer,manager,admin),
    'news.write',editor) || jsonb_build_object(
    'schedule.write',editor,
    'schedule.editor.read',viewer,
    'schedule.participants.read',public.schedule_participants_read_rule(viewer,editor,admin),
    'schedule.feedback.read',public.schedule_feedback_read_rule(viewer,admin),
    'speakers.write',editor,
    'speakers.editor.read',viewer,
    'services.write',manager,
    'participants.write',public.participant_manage_rule(manager,admin),
    'participants.contacts.read',public.participant_contacts_read_rule(editor,manager,coalesce(p_occasion_user.is_approver,false)),
    'groups.assignments.write',public.group_assignments_write_rule(editor,manager,admin,unit_editor),
    'blueprints.write',public.blueprint_write_rule(editor,manager),
    'inventory.copy.target',public.inventory_copy_target_rule(order_writer,unit_manager),
    'activities.write',editor,
    'activities.editor.read',map_reader,
    'information.write',editor,
    'unit_information.read',coalesce(p_unit_user.is_editor_view,false),
    'unit_information.write',unit_editor,
    'scanner.settings.write',public.scanner_settings_rule(actor_present,editor,order_writer),
    'reception.use',public.reception_use_rule(p_reception_enabled,p_occasion_user.is_receptionist,manager,admin),
    'information.editor.read',viewer,
    'map.places.write',editor,
    'groups.editor.read',map_reader,
    'groups.create',editor,
    'map.editor.read',map_reader,
    'reception.participants.manage',public.participant_manage_rule(manager,admin),
    'unit_users.read',public.unit_users_read_rule(p_unit_user.is_manager,p_unit_user.is_editor,p_unit_user.is_editor_view),
    'unit_users.write',unit_manager,
    'navigation.admin_app',administration_navigation,
    'navigation.admin_web',administration_navigation OR p_has_units,
    'navigation.administration',p_demo_read OR coalesce(p_unit_user.is_editor_view,false) OR viewer,
    'navigation.unit_workspace',public.unit_workspace_navigation_rule(p_current_unit_listed,unit_editor,unit_manager,p_unit_user.is_editor_view));
END;
$$;
REVOKE ALL ON FUNCTION public.get_context_capabilities_v1(bigint,public.occasion_users,public.unit_users,boolean,boolean,boolean,boolean,boolean,boolean,boolean)
 FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.get_context_capabilities_v1(bigint,public.occasion_users,public.unit_users,boolean,boolean,boolean,boolean,boolean,boolean,boolean) TO postgres;

CREATE OR REPLACE FUNCTION public.get_user_groups_for_context_internal_v1(
 p_occasion bigint,p_editor boolean,p_viewer boolean,p_writable boolean)
RETURNS jsonb LANGUAGE sql STABLE SET search_path=public,extensions AS $$
 SELECT coalesce(jsonb_object_agg(g.id,jsonb_build_object(
 'id',g.id,'title',g.title,'type',g.type,'place',g.place,'description',g.description,
 'occasion',g.occasion,'data',g.data,'is_admin',mine.is_admin,
 'capabilities',jsonb_build_object(
 'groups.write',public.group_write_rule(p_editor,mine.is_admin,p_writable),
 'groups.editor.read',public.group_editor_read_rule(p_viewer,p_editor,mine.is_admin),
 'map.place.move',public.place_move_rule(p_editor,mine.is_admin,coalesce(p.type='group' AND p.is_hidden,false),p_writable)))),
 '{}'::jsonb)
 FROM public.user_groups mine JOIN public.user_group_info g ON g.id=mine."group"
 LEFT JOIN public.places p ON p.id=g.place AND p.occasion=g.occasion
 WHERE mine."user"=auth.uid() AND g.occasion=p_occasion;
$$;
REVOKE ALL ON FUNCTION public.get_user_groups_for_context_internal_v1(bigint,boolean,boolean,boolean) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.get_user_groups_for_context_internal_v1(bigint,boolean,boolean,boolean) TO postgres;

CREATE OR REPLACE FUNCTION public.get_sign_in_recipient_context_v1(p_user uuid,p_occasion bigint)
RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=public,extensions AS $$
BEGIN
 PERFORM public.require_service_role();
 RETURN (SELECT jsonb_build_object('data',m.data,'is_editor',m.is_editor,
  'is_editor_view',m.is_editor_view,'is_manager',m.is_manager,
  'capabilities',jsonb_build_object(
    'emails.team_access_notice',public.team_access_notice_rule(m.is_editor,m.is_editor_view,m.is_manager)))
 FROM public.occasion_users m WHERE m."user"=p_user AND m.occasion=p_occasion);
END $$;
REVOKE ALL ON FUNCTION public.get_sign_in_recipient_context_v1(uuid,bigint) FROM PUBLIC,anon,authenticated;
GRANT EXECUTE ON FUNCTION public.get_sign_in_recipient_context_v1(uuid,bigint) TO service_role;

CREATE OR REPLACE FUNCTION public.bank_context_capabilities(p_admin boolean,p_unit_manager boolean,p_demo boolean)
RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
 SELECT jsonb_build_object(
    'bank_accounts.write',public.bank_account_write_rule(p_admin,p_unit_manager,p_demo),
    'bank_accounts.users.write',public.bank_account_write_rule(p_admin,p_unit_manager,p_demo),
    'bank_sync.manage',public.bank_account_write_rule(p_admin,p_unit_manager,p_demo),
    'bank_transactions.manage',public.bank_account_write_rule(p_admin,p_unit_manager,p_demo));
$$;
REVOKE ALL ON FUNCTION public.bank_context_capabilities(boolean,boolean,boolean) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.bank_context_capabilities(boolean,boolean,boolean) TO postgres;

-- Organization administration has its own scope, including a unit-only
-- context. Occasion demo administration does not substitute for this fact.
CREATE OR REPLACE FUNCTION public.organization_context_capabilities(p_admin boolean)
RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
 SELECT jsonb_build_object(
   'organization.settings.write',coalesce(p_admin,false));
$$;
REVOKE ALL ON FUNCTION public.organization_context_capabilities(boolean) FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.organization_context_capabilities(boolean) TO postgres;
