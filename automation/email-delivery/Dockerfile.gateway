# Build from repository root. No credentials belong in this build context/image.
ARG DENO_BASE=denoland/deno@sha256:8d24854de78a79c56e74b49aa4c5996c60e1fe3730efba8fbdd2692c582e6e29
FROM ${DENO_BASE}
ENV DENO_DIR=/opt/deno-cache
USER root
WORKDIR /functions
COPY supabase/functions/_shared /functions/_shared
COPY supabase/functions/send-email-gateway /functions/send-email-gateway
# Include the literal dynamic RPC dependency explicitly in the immutable cache.
RUN deno cache /functions/send-email-gateway/index.ts /functions/_shared/supabaseUtil.ts \
    && chmod -R a+rX /opt/deno-cache /functions
USER deno
ENTRYPOINT ["deno"]
