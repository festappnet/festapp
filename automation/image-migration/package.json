{
  "name": "festapp-migration",
  "version": "1.0.0",
  "description": "Migration scripts for Supabase Storage to Cloudflare R2",
  "type": "module",
  "scripts": {
    "migrate": "node migrate-files.js",
    "migrate:dry": "node migrate-files.js --dry-run",
    "rewrite": "node rewrite-urls.js",
    "rewrite:dry": "node rewrite-urls.js --dry-run",
    "verify": "node verify.js",
    "private:inventory": "node private-bucket-cutover.js --inventory",
    "private:copy": "node private-bucket-cutover.js --copy",
    "private:verify": "node private-bucket-cutover.js --verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@supabase/supabase-js": "^2.39.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.3.0",
    "p-limit": "^5.0.0",
    "pg": "^8.13.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "pnpm": "11.24.0"
  }
}
