# Supabase project reference ID (the subdomain before .supabase.co)
SUPABASE_PROJECT_REF=PROJECT_REF

# PostgreSQL connection string (required for all scripts)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase credentials (optional — only needed for verify.js file count parity check)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 credentials (required for find-orphans.js, optional for verify.js)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=festapp-images
R2_PUBLIC_BUCKET_NAME=festapp-images
R2_PRIVATE_BUCKET_NAME=festapp-images-private
PRIVATE_CUTOVER_LEDGER=.private-cutover-ledger.jsonl
PRIVATE_CUTOVER_BATCH_SIZE=100
