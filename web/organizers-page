/* Product overview: one demonstration per task, with real output alongside. */
.product-links{display:flex;flex-wrap:wrap;gap:6px 28px;margin-top:22px}
.feature#planek h2{grid-row:1/3;line-height:1.08}
.feature#planek .product-links{grid-column:2;margin-top:18px}
.product-pair{padding-block:68px}
