.product-pair .feature-copy h2{grid-column:1;grid-row:1/4;max-width:18ch;font-size:clamp(36px,4vw,54px);line-height:1.1}
.product-pair .feature-copy>p:not(.eyebrow){grid-column:2;max-width:53ch;margin-top:0;font-size:19px;line-height:1.65}
.product-pair .feature-copy .feature-detail{margin-top:14px;font-size:17px!important}
.product-pair .product-links{grid-column:2}
.product-pair-media{display:grid;grid-template-columns:minmax(0,1fr) 260px;align-items:center;gap:72px;margin-top:40px}
.product-pair-media figure{min-width:0;margin:0}
.product-pair-media figcaption{margin-top:14px;text-align:center;color:var(--muted);font-size:14px;line-height:1.5}
.product-ticket img{width:auto;height:auto;max-height:420px;max-width:100%;margin:auto;transform:rotate(4deg)}
.product-scanner{max-width:240px;justify-self:center}
.product-scanner .media-stage{background:transparent;border:0;box-shadow:none;border-radius:0}
.product-scanner .media-stage video{aspect-ratio:1/2!important;width:100%;height:auto;object-fit:contain}
.product-pair-operations .product-pair-media{align-items:center}
@media(max-width:760px){
 .feature#planek h2{font-size:38px}
